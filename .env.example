# ==============================================================================
# Mac mini Personal Assistant 設定檔範本 (.env.example)
# 請複製此檔案為 .env 並填入您的自訂設定：cp .env.example .env
# ==============================================================================

# 1. 服務監聽設定
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8899

# 2. 捷徑安全性金鑰 (Apple Watch / iPhone Shortcuts Request Header: X-Agent-Key)
ASSISTANT_API_KEY=your-secret-api-key-here

# 3. Tailscale 網域名稱 (用於報告產出與安全內網連線)
# 例如: mac-mini.tailnet-xyz.ts.net
TAILSCALE_DOMAIN=your-mac-mini.ts.net

# 4. 大腦核心引擎模式：
# - 'agy' (Google Antigravity CLI, 推薦)
# - 'omp' (Oh My Pi)
# - 'direct' (直接調用 OpenAI 相容 API)
AGENT_ENGINE=agy

# Antigravity CLI (agy) 路徑與模型級別設定 (預設讀取 PATH 或 ~/.local/bin/agy)
# AGY_BIN=/Users/<YOUR_USERNAME>/.local/bin/agy
AGY_MODEL=gemini-3.8-flash-low
AGY_MODEL_LOW=gemini-3.8-flash-low
AGY_MODEL_MED=gemini-3.8-flash-medium
AGY_MODEL_HIGH=gemini-3.8-flash-high

# 5. Telegram Bot 雙向互動設定 (選填，強烈建議啟用)
# 向 @BotFather 申請機器人取得 TOKEN，向 @userinfobot 取得您的數字 CHAT_ID
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# 6. 上下文保護與自動重啟閾值 (防 Token 膨脹與記憶體洩漏)
CONTEXT_WINDOW_LIMIT=1000000
CONTEXT_RESTART_THRESHOLD=0.30
CONTEXT_IDLE_MINUTES=10

# 7. 每日記憶審查與自動歸檔排程 (預設 23:30)
MEMORY_SYNC_HOUR=23
MEMORY_SYNC_MINUTE=30

# 8. 專屬技能選填設定 (可依需求逐步填寫)
# ------------------------------------------------------------------------------
# [Google Workspace CLI (gws)]：用於 Gmail、Google Calendar、Google Sheets
# 請依循各 Skill 說明執行 gws auth setup 綁定授權
# GOOGLE_CALENDAR_TODO_ID=your-calendar-id@group.calendar.google.com

# [家庭待買清單 (shopping-list)]
# 填入您建立的 Google Sheets 試算表 ID（網址 /d/ 後面的長字串）
SHOPPING_SHEET_ID=your-google-sheet-id-here

# [iMessage 安全白名單]
OWNER_PHONE=+886900000000
FAMILY_PHONE=+886911111111

# [蝦皮賣家中心 (shopee-seller)]
# SHOPEE_SHOP_ID=your_shop_id
# SHOPEE_USERNAME=your_username
# SHOPEE_PASSWORD=your_password
